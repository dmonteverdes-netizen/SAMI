# SAMI Platform Configuration

# Environment
NODE_ENV=development
PORT=3000

# Fase Activa de Despliegue de SAMI (Backend Feature Flags)
# Define qué módulos y endpoints están habilitados y auditados en el servidor.
# Regla de Arquitectura de Seguridad: La fase del servidor manda. Si el frontend tiene fase 2 y el servidor fase 1, gana el servidor.
# Valores válidos:
#   1 = MVP Contable (Dashboard, Ventas/Emisión, Compras/Gastos, Gestión General, Consola Admin, Notificaciones, Consentimiento Ley 29733)
#   2 = Financiamiento (Marketplace de Créditos, Perfil de Riesgo, Consola y APIs B2B de Entidades Financieras Aliadas, Factoring)
#   3 = Aprender (Academia SAMI, Cursos y Certificaciones formativas, Glosario MYPE)
#   4 = Productividad & IA (Asistente Inteligente SAMI AI / Gemini, Gestor de Tareas y Agenda SUNAT, Programa de Fidelización SAMI Coins)
SAMI_ACTIVE_PHASE=1

# AI Configuration (Backend only - NEVER expose to frontend bundle)
GEMINI_API_KEY=your_gemini_api_key_here

# Integrations (PSE - Proveedor de Servicios Electrónicos)
PSE_API_URL=https://api.pse-provider.pe/v1
PSE_API_TOKEN=your_pse_token_here

# Bank Marketplace & Open Finance API (Entidades Financieras Aliadas)
BANK_API_OAUTH_TOKEN=your_bank_api_token_here
BANK_OAUTH_CLIENT_ID=your_bank_client_id_here
BANK_OAUTH_CLIENT_SECRET=your_bank_client_secret_here

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:soporte@sami.pe

# Payment Gateway (Culqi / Pasarelas Aliadas)
CULQI_PUBLIC_KEY=pk_test_sample_key
CULQI_SECRET_KEY=sk_test_sample_key

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/sami_db

# Security & CORS
JWT_SECRET=your_jwt_secret_key_here
ADMIN_2FA_SECRET=your_2fa_secret_here
ALLOWED_ORIGINS=https://sami.pe,http://localhost:3000
PRIVACY_POLICY_VERSION=2026.1
