
# SAMI MVP Configuration

# Environment
NODE_ENV=development
PORT=3000

# AI Configuration
GEMINI_API_KEY=your_gemini_key_here

# Integrations (PSE - Proveedor de Servicios Electrónicos)
PSE_API_URL=https://api.pse-provider.pe/v1
PSE_API_TOKEN=your_pse_token_here

# Payment Gateway (Culqi/Niubiz)
CULQI_PUBLIC_KEY=pk_test_...
CULQI_SECRET_KEY=sk_test_...

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Security
JWT_SECRET=your_super_secret_for_tokens
ADMIN_2FA_SECRET=your_2fa_secret
